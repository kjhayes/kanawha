
menu "Qemu Specific Devices"

config QEMU_PCI_TEST_DEVICE
    tristate "PCI Test Device"
    default n
    depends on PCI
    help
      Include a driver for the QEMU PCI test device

config QEMU_PCI_EDU_DEVICE
    tristate "PCI EDU Device"
    default n
    depends on PCI
    help
      Include a driver for the QEMU PCI EDU device

endmenu

