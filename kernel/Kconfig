menu "Debug Options"
config DEBUGGING
    bool "Enable Debugging Options"
    default n
    help
      Root Debugging Config Option

config DEBUG_SYMBOLS
    bool "Include Debug Symbols"
    depends on DEBUGGING
    default y
    help
      Include debug symbols in kernel binary

config DEBUG_ASSERTIONS
    bool "Enable Debug Assertions"
    depends on DEBUGGING
    default y
    help
      Enable DEBUG_ASSERT Checking

config PERCPU_DEBUG_ASSERTIONS
    bool "Enable percpu Variable Debug Assertions"
    depends on DEBUGGING && DEBUG_ASSERTIONS
    default n
    help
      Enable the DEBUG_ASSERT_PERCPU_VALID assertion, which includes a percpu checksum variable
      used to make sure that the percpu variable subsystem is working correctly.

config DISABLE_NORETURN_ATTRIBUTE
    bool "Disable __noreturn Attribute"
    depends on DEBUGGING
    default y
    help
      Disable the __noreturn attribute so that the compiler correctly generates backtraces when debugging.

menu "Kernel Address Checking"
config DEBUG_HIGHER_HALF_KERNEL_ADDRESSES
    bool "Higher Half Addresses"
    depends on DEBUGGING
    default y
    help
      Check that pointers are in the higher half of memory during KERNEL_ADDR checks
endmenu

config DEBUG_BUDDY_ALLOC
    bool "Debug Buddy Allocators"
    depends on DEBUGGING
    default n
    help
      Debug kernel Buddy Allocators

config DEBUG_INIT_STAGES
    bool "Debug init Stages Framework"
    depends on DEBUGGING
    default n
    help
      Debug the init Stages Framework

config DEBUG_DUMP_THREADS_PERIODICALLY
    bool "Dump Thread Info Periodically"
    depends on DEBUGGING
    default n

config DEBUG_DUMP_THREADS_PERIODICALLY_PERIOD
    int "Dump Thread Period (sec)"
    depends on DEBUG_DUMP_THREADS_PERIODICALLY
    default 60

config DEBUG_TRACK_PROCESS_EXEC
    bool "Track Process Exec Path"
    depends on DEBUGGING
    default y
    help
      Track the path string as a process uses the "exec" system call

config DEBUG_X64_PEDANTIC_VERIFY_PAGE_TABLES
    bool "Verify x64 Page Tables Pedantically"
    depends on X64 && DEBUGGING
    default n
    help
      Add checks to verify x64 page tables any time that one is manipulated.
      This helps find issues with the page table handling code on x64 effectively,
      but can drastically slow down the kernel.

config DEBUG_PROCESS_TERMINATION
    bool "Log Process Termination"
    depends on DEBUGGING
    default n

menu "Strace Options"

config STRACE_LOG_SYSCALL_BEGIN
    bool "Debug Log All syscall Beginnings"
    depends on DEBUGGING
    default n
    help
      Log the beginning of each syscall (process ID and syscall ID)

config STRACE_LOG_SYSCALL_END
    bool "Debug Log All syscall Completions"
    depends on DEBUGGING
    default n
    help
      Log the ending of each syscall, useful for debugging kernel bugs during the handling of a specific syscall

config STRACE_LOG_SIGNALS
    bool "Debug Log signals"
    depends on DEBUGGING
    default n

config STRACE_TIME_SYSCALLS
    bool "Time syscall Execution"
    depends on DEBUGGING
    default n

endmenu

