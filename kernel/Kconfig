config DISPLAY_LOGO_ON_FRAMEBUFFER_MODESET
    bool "Display Logo on Framebuffer Modeset"
    default y
    select LOGO_DATA

endmenu

config LOGO_DATA
    def_bool n
    help
        Should data for the kanawha logo be compiled into the kernel?
	(Should not be chosen explicitly)

