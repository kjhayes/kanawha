
ENTRY( x64_kernel_entry )

#define __LINKER__
#include <kanawha/init.h>

#include "util.ldh"

#define KERNEL_VIRTUAL_ADDR (CONFIG_IDMAP_STATIC_VIRTUAL_BASE + CONFIG_X64_KERNEL_LOAD_ADDR)
#define VA_TO_PA(addr) (addr-CONFIG_IDMAP_STATIC_VIRTUAL_BASE)

PHDRS
{
header PT_PHDR PHDRS FLAGS(4);
phdrs PT_LOAD FILEHDR PHDRS FLAGS(5);
#include "phdrs.ldh"
}

SECTIONS
{  
  . = CONFIG_X64_KERNEL_LOAD_ADDR;

  __x64_kernel_phys_start = .;

  .hdrs ALIGN(16) : AT(CONFIG_X64_KERNEL_LOAD_ADDR) {
    *(.hdrs*) 
    *(.hdrs.*)
  } :header :phdrs

  .boot.text ALIGN(16) : AT(ADDR(.boot.text)) {
      *(.boot.text*) *(boot.text.*)
  } :boot = 0xcccccccc
  .boot.data ALIGN(0x1000) : AT(ADDR(.boot.data)) {
      *(.boot.data*) *(.boot.data.*)
  } :boot = 0

  . = KERNEL_VIRTUAL_ADDR + (LOAD_AFTER(.boot.data) - CONFIG_X64_KERNEL_LOAD_ADDR);
  __x64_kernel_virt_start = .;

  .text ALIGN(0x1000) : AT(VA_TO_PA(ADDR(.text))) {
    *(.text*)
    *(.text.*)
  } :text = 0xcccccccc /* fill empty regions with int3 */

  .rodata : AT(VA_TO_PA(ADDR(.rodata))) {
    *(.srodata .srodata.*)
    *(.rodata .rodata.*)
  } :rodata = 0

  .data : AT(VA_TO_PA(ADDR(.data))) {
    *(.sdata .sdata.*)
    *(.data .data.*)
    *(.tdata .tdata.*)
  } :data = 0

  .bss : AT(VA_TO_PA(ADDR(.bss))) {
    *(.sbss .sbss.*)
    *(.bss .bss.*)
    *(.tbss .tbss*)
  } :data = 0

// Past Here Everything Should be Discardable After Kernel Initialization

#include "kpercpu.ldh"
#include "kinit.ldh"
#include "ksymtab.ldh"

  __x64_kernel_virt_end = .;

#include "kuser.ldh"

  . = ALIGN(0x1000);

  __x64_kernel_phys_end = VA_TO_PA(.);

  .shstrtab : {
     *(.shstrtab* .shstrtab.*)
  } :note

  .strtab : {
     *(.strtab* .strtab.*) 
  } :note

  /* Debugging Sections */
#ifdef CONFIG_DEBUGGING
//  .debug_types : {
//      *(.debug_types* .debug_types.*)
//  } :note
//  .debug_str : {
//      *(.debug_str .debug_str.*)
//  } :note
//  .debug_aranges : {
//      *(.debug_aranges* .debug_aranges.*)
//  } :note
//  .debug_loc : {
//      *(.debug_loc* .debug_loc.*)
//  } :note
//  .debug_line : {
//      *(.debug_line* .debug_line.*)
//  } :note
//  .debug_abbrev : {
//      *(.debug_abbrev* .debug_abbrev.*)
//  } :note
//  .debug_pubnames : {
//      *(.debug_pubnames* .debug_pubnames.*)
//  } :note
//  .debug_pubtypes : {
//      *(.debug_pubtypes* .debug_pubtypes.*)
//  } :note
#endif

  /* Discard Sections */

//  .got : {
//  	*(.got) *(.igot.*)
//  }
//  ASSERT(SIZEOF(.got) == 0, "Unexpected GOT entries detected!")
  
  .plt : {
  	*(.plt) *(.plt.*) *(.iplt)
  }
  ASSERT(SIZEOF(.plt) == 0, "Unexpected run-time procedure linkages detected!")
  
  .rel.dyn : {
  	*(.rel.*) *(.rel_*)
  }
  ASSERT(SIZEOF(.rel.dyn) == 0, "Unexpected run-time relocations (.rel) detected!")
  
  .rela.dyn : {
  	*(.rela.*) *(.rela_*)
  }
  ASSERT(SIZEOF(.rela.dyn) == 0, "Unexpected run-time relocations (.rela) detected!")

  /DISCARD/ : {
      *(.eh_frame* .eh_frame.*)
      *(.comment* .comment.*)
      *(.kmodinfo* .kmodinfo.*)
  }
}
