
menu "x64 Options"
  depends on X64

config X64_KERNEL_LOAD_ADDR
  hex "Kernel Load Address"
  default 0x0
  help
    Physical Address the Kernel should be loaded at.

config X64_BOOT_STACK_SIZE
  hex "Boot Stack Size"
  default 0x4000
  help
    Size of the boot-time stack used for kernel initialization

config X64_PROT_MODE_TO_LONG_MODE
  bool "Protected Mode to Long Mode Support"
  default n
  help
    Include support for the transition from 32-bit protected mode to 64-bit long mode

choice
  prompt "Boot Method"
  default X64_MULTIBOOT2_BOOT
  config X64_MULTIBOOT2_BOOT
    select MULTIBOOT2
    select X64_PROT_MODE_TO_LONG_MODE
    bool "Multiboot2"
endchoice

config X64_IMPLEMENT_VMEM_DIRECTLY
  bool "Implement vmem Directly"
  default y
  select IMPLEMENT_VMEM_DIRECTLY
  help
    Provide implementation of vmem subsystem directly
    instead of using the paging subsystem.

config X64_ASSUME_2MB_PAGES
  bool "Assume Support for 2MB Pages"
  default n

config X64_ASSUME_1GB_PAGES
  bool "Assume Support for 1GB Pages"
  depends on X64_ASSUME_2MB_PAGES
  default n

config X64_BOOT_VGA
  bool "Use Early Platform VGA for printk"
  default y

config X64_BOOT_VGA_POST_LAUNCH
  bool "Keep Using Early Platform VGA for printk After Boot"
  default n
  depends on X64_BOOT_VGA

config X64_BOOT_SERIAL
  bool "Use Early Platform Serial Port for printk"
  default y

config X64_BOOT_SERIAL_POST_LAUNCH
  bool "Keep Using Early Serial Port for printk After Boot"
  default n
  depends on X64_BOOT_SERIAL

config X64_TEST_VOLATILITY_THREAD
  tristate "Debug Thread Volatility in Background Thread"
  default n

config X64_IGNORE_MADT_LAPIC
  bool "Ignore extra LAPIC found in MADT"
  default n

config X64_IGNORE_MADT_X2APIC
  bool "Ignore extra x2APIC found in MADT"
  default n

config X64_ENABLE_CALL_GATE_SYSCALL
  bool "Include Call Gate Syscall Support (WIP/Unimplemented)"
  default n
  depends on WIP

config X64_IGNORE_APIC_MSI
  bool "Disable Use of  LAPIC for PCI MSI/MSI-X"
  default n
  depends on PCI

endmenu

