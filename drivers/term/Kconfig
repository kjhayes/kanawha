
config SERIAL_8250
    tristate "8250 Based Serial UART(s)"
    default y
    help
      Framework to support 8250-based serial UART devices

config VIRTIO_CONSOLE
    bool "Virtio Console"
    default n
    depends on VIRTIO && WIP

config QEMU_SERIAL
    bool "QEMU PCI Serial"
    default n
    depends on PCI

source "drivers/term/8250/Kconfig"

config PL011_SERIAL
    bool "PL011 Serial"
    default n
    depends on DEVICETREE

config PL011_SERIAL_AT_BOOT
    bool "Use PL011 Serial at Boot"
    default n
    depends on PL011_SERIAL

config PL011_SERIAL_AT_BOOT_ADDR
    hex "PL011 Serial Boot Register Base"
    default 0x0
    depends on PL011_SERIAL_AT_BOOT
